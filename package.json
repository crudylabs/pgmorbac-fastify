{
  "name": "@crudy/pgmorbac-fastify",
  "version": "1.0.0",
  "type": "module",
  "description": "Fastify layer over pgmorbac: permission checks, RLS session context, management routes, PostgREST data proxy, migration loader",
  "keywords": [
    "access-control",
    "authorization",
    "fastify",
    "morbac",
    "multi-tenant",
    "orbac",
    "pgmorbac",
    "postgresql",
    "rbac",
    "rls"
  ],
  "author": "Marc Villain",
  "homepage": "https://pgmorbac.crudy.fr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crudylabs/pgmorbac-fastify.git"
  },
  "bugs": {
    "url": "https://github.com/crudylabs/pgmorbac-fastify/issues"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "source": "./src/permissions.ts",
      "default": "./dist/permissions.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "source": "./src/proxy.ts",
      "default": "./dist/proxy.js"
    },
    "./list-query": {
      "types": "./dist/list-query.d.ts",
      "source": "./src/list-query.ts",
      "default": "./dist/list-query.js"
    },
    "./rls-context": {
      "types": "./dist/rls-context.d.ts",
      "source": "./src/rls-context.ts",
      "default": "./dist/rls-context.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "source": "./src/plugin.ts",
      "default": "./dist/plugin.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "source": "./src/schemas.ts",
      "default": "./dist/schemas.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "source": "./src/api.ts",
      "default": "./dist/api.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "source": "./src/migrations.ts",
      "default": "./dist/migrations.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "check": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@crudy/pgmorbac": "^1.0.0",
    "bcryptjs": "^2"
  },
  "peerDependencies": {
    "fastify": ">=5",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^2",
    "@types/pg": "^8",
    "fastify": "^5",
    "pg": "^8",
    "typescript": "^5"
  }
}
